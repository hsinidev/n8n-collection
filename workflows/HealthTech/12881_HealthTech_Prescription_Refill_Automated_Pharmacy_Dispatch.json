      "position": [
        760,
        340
      ],
      "parameters": {
        "fromEmail": "notifications@hsini.dev",
        "toEmail": "=admin@hsini.dev",
        "subject": "=Alert: {{ $json.title || 'Enterprise Notification' }}"
      },
      "notes": "Automated enterprise step 3 for HealthTech workflows. Maintained by hsini.dev."
