{
  "id": "wflow_83d76a8268",
  "name": "Snowflake Daily Data Warehouse Sync - Enterprise Suite #16820",
  "meta": {
    "instanceId": "inst-aebdcfab",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:33:17.687933+00:00",
    "updatedAt": "2026-08-14T17:33:17.687933+00:00",
