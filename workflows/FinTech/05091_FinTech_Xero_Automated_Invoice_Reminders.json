    },
    {
      "id": "f4c2a69f-0464-45c4-91d9-0470a8138800",
      "name": "HTTP Enterprise Connector (2)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        345
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.hsini.dev/v1/enterprise-endpoint",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "notes": "Automated enterprise step 2 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "61d53713-c15b-459f-b2ce-f5ab36c1c3d5",
