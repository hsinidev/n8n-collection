      "name": "Cron Scheduler (1)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        305
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "notes": "Automated enterprise step 1 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "9997709e-183e-43a8-a2c3-e871222399cb",
      "name": "HTTP Enterprise Connector (2)",
