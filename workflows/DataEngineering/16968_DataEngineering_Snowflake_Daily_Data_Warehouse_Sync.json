{
  "id": "wflow_f7c84afa8f",
  "name": "Snowflake Daily Data Warehouse Sync - Enterprise Suite #16968",
  "meta": {
    "instanceId": "inst-5436a1f1",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:33:18.781243+00:00",
    "updatedAt": "2026-08-14T17:33:18.781243+00:00",
