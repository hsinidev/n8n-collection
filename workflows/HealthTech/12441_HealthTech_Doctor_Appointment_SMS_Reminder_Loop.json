{
  "id": "wflow_2fd52cbbde",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12441",
  "meta": {
    "instanceId": "inst-c201ff56",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:52.421703+00:00",
