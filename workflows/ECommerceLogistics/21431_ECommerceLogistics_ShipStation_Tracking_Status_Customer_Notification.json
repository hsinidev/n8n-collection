  "nodes": [
    {
      "id": "e87792b6-4a1c-42fa-a77f-3d5f194783cd",
      "name": "Webhook Trigger (1)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        365
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-ingress",
        "responseMode": "responseNode"
      },
      "notes": "Automated enterprise step 1 for ECommerceLogistics workflows. Maintained by hsini.dev."
    },
    {
      "id": "c808f088-e9c7-46ca-a4b3-20262cdb64d9",
      "name": "Twilio SMS Dispatcher (2)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1.2,
      "position": [
        500,
        230
      ],
      "parameters": {
        "message": "=Alert: {{ $json.alert || 'System notification' }}"
      },
      "notes": "Automated enterprise step 2 for ECommerceLogistics workflows. Maintained by hsini.dev."
    },
    {
      "id": "b3a24baf-7cad-464d-abb1-2cf9064f4257",
      "name": "Postgres Data Sync (3)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        760,
        340
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 3 for ECommerceLogistics workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
    "Webhook Trigger (1)": {
      "main": [
