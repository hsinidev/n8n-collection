{
  "id": "wflow_2f8cfdf43c",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #11886",
  "meta": {
    "instanceId": "inst-b24ef092",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:51.352413+00:00",
    "updatedAt": "2026-08-14T17:32:51.352413+00:00",
