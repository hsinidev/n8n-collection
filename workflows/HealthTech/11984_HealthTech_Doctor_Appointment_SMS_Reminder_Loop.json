{
  "id": "wflow_4801b1e34c",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #11984",
  "meta": {
    "instanceId": "inst-da9ae6d2",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:51.528871+00:00",
