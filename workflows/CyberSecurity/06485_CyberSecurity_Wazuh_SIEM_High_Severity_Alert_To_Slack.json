      "name": "Slack Notification (3)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        760,
        340
      ],
      "parameters": {
        "channel": "automation-alerts",
        "text": "=\u26a1 Enterprise Event Executed: {{ $json.event || 'Success' }}"
      },
      "notes": "Automated enterprise step 3 for CyberSecurity workflows. Maintained by hsini.dev."
    },
    {
      "id": "7f716894-f131-412c-87bc-5656aede3d27",
      "name": "Postgres Data Sync (4)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1020,
        275
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 4 for CyberSecurity workflows. Maintained by hsini.dev."
    }
