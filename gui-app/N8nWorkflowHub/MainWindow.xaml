<Window x:Class="N8nWorkflowHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="⚡ n8n Enterprise Workflow Hub — 22,500+ Workflows Visual Workstation by Hsini Mohamed (hsini.dev)" 
        Height="850" Width="1400"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#080C14"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI, Inter, sans-serif">

    <Window.Resources>
        <!-- Modern ScrollBar & Control Styles -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <Style x:Key="HeaderBadge" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabHeaderStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" BorderThickness="1,1,1,0" BorderBrush="#1E293B">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Header -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ─── TOP HEADER BAR ─── -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Title & Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#6366F1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="n8n Enterprise Workflow Hub" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="22,500+ Production Templates • Visual Architecture &amp; Search" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Stats Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource HeaderBadge}">
                        <TextBlock Text="📦 22,500 Workflows" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    </Border>
                    <Border Style="{StaticResource HeaderBadge}">
                        <TextBlock Text="📁 205 Categories" FontSize="11" Foreground="#A78BFA" FontWeight="SemiBold"/>
                    </Border>
                    <Border Style="{StaticResource HeaderBadge}">
                        <TextBlock Text="🎨 Visual Canvas" FontSize="11" Foreground="#F43F5E" FontWeight="SemiBold"/>
                    </Border>
                    <Border Style="{StaticResource HeaderBadge}">
                        <TextBlock Text="🔒 100% Offline Single EXE" FontSize="11" Foreground="#34D399" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Developer Attribution Link -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnVisitPortfolio_Click" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#374151" BorderThickness="1" Padding="12,6" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Architect: Hsini Mohamed" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                        <TextBlock Text=" ↗" FontSize="12" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ─── MAIN 3-COLUMN WORKSPACE ─── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400"/> <!-- Left Sidebar: Categories -->
                <ColumnDefinition Width="380" MinWidth="300"/>                  <!-- Center: Workflows List -->
                <ColumnDefinition Width="*"/>                                   <!-- Right: Visual Canvas & Code Preview -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT SIDEBAR: CATEGORIES ── -->
            <Border Grid.Column="0" Background="#0A0E17" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CATEGORIES &amp; DOMAINS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="4,0,0,8"/>

                    <!-- Category Search -->
                    <TextBox x:Name="TxtCategoryFilter" Grid.Row="1" 
                             Background="#131D31" Foreground="#F8FAFC" BorderBrush="#334155" 
                             Padding="8,6" Margin="0,0,0,10"
                             GotFocus="TxtCategoryFilter_GotFocus"
                             LostFocus="TxtCategoryFilter_LostFocus"
                             TextChanged="TxtCategoryFilter_TextChanged"/>

                    <!-- Categories List -->
                    <ListBox x:Name="LstCategories" Grid.Row="2" 
                             Background="Transparent" BorderThickness="0" 
                             Foreground="#CBD5E1"
                             SelectionChanged="LstCategories_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count, StringFormat='{}{0:N0}'}" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#312E81"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ── CENTER: WORKFLOWS LIST & SEARCH ── -->
            <Border Grid.Column="1" Background="#080C14" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Input Box -->
                    <TextBox x:Name="TxtSearchQuery" Grid.Row="0"
                             Background="#131D31" Foreground="#F8FAFC" BorderBrush="#3B82F6" BorderThickness="1"
                             FontSize="13" Padding="10,8" Margin="0,0,0,8"
                             GotFocus="TxtSearchQuery_GotFocus"
                             LostFocus="TxtSearchQuery_LostFocus"
                             TextChanged="TxtSearchQuery_TextChanged"/>

                    <!-- Node Filter Dropdown -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Filter Node:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbNodeFilter" Grid.Column="1" Background="#131D31" Foreground="#F8FAFC"
                                  SelectionChanged="CmbNodeFilter_SelectionChanged" Padding="6,4">
                            <ComboBoxItem Content="All Nodes" IsSelected="True"/>
                            <ComboBoxItem Content="openAi"/>
                            <ComboBoxItem Content="webhook"/>
                            <ComboBoxItem Content="scheduleTrigger"/>
                            <ComboBoxItem Content="postgres"/>
                            <ComboBoxItem Content="slack"/>
                            <ComboBoxItem Content="telegram"/>
                            <ComboBoxItem Content="httpRequest"/>
                            <ComboBoxItem Content="stripe"/>
                            <ComboBoxItem Content="shopify"/>
                            <ComboBoxItem Content="code"/>
                            <ComboBoxItem Content="switch"/>
                        </ComboBox>
                    </Grid>

                    <!-- Results Counter Text -->
                    <TextBlock x:Name="TxtResultsCount" Grid.Row="2" Text="Loading workflows..." FontSize="11" Foreground="#94A3B8" Margin="2,0,0,8"/>

                    <!-- Workflows ListBox -->
                    <ListBox x:Name="LstWorkflows" Grid.Row="3"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="LstWorkflows_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#101726" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,3">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="4,2" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#60A5FA" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayNodes}" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="WfBd" Background="Transparent" CornerRadius="8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="WfBd" Property="BorderBrush" Value="#6366F1"/>
                                                    <Setter TargetName="WfBd" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ── RIGHT: VISUAL ARCHITECTURE CANVAS & CODE PREVIEW ── -->
            <Border Grid.Column="2" Background="#0C121E" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Meta -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Tabs: Visual Canvas & Code -->
                    </Grid.RowDefinitions>

                    <!-- Workflow Header Details -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtSelectedTitle" Text="Select a Workflow to View Visual Flow Diagram" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Border x:Name="TagCategory" Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                <TextBlock x:Name="TxtSelectedCategory" Text="Category: None" FontSize="11" Foreground="#38BDF8"/>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                <TextBlock x:Name="TxtSelectedNodeCount" Text="Nodes: 0" FontSize="11" Foreground="#A78BFA"/>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                <TextBlock x:Name="TxtSelectedId" Text="ID: -" FontSize="11" Foreground="#94A3B8"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Action Buttons Toolbar -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                        <!-- Copy to Clipboard -->
                        <Button x:Name="BtnCopyJson" Click="BtnCopyJson_Click" 
                                Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold"
                                Padding="14,8" Margin="0,0,8,6" Cursor="Hand" Style="{StaticResource ActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋 " FontSize="14"/>
                                <TextBlock Text="Copy JSON to Clipboard" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Download JSON -->
                        <Button x:Name="BtnSaveJson" Click="BtnSaveJson_Click" 
                                Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold"
                                Padding="12,8" Margin="0,0,8,6" Cursor="Hand" Style="{StaticResource ActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾 " FontSize="14"/>
                                <TextBlock Text="Save .json File" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Export Category -->
                        <Button x:Name="BtnExportCategory" Click="BtnExportCategory_Click" 
                                Background="#8B5CF6" Foreground="#FFFFFF" FontWeight="Bold"
                                Padding="12,8" Margin="0,0,8,6" Cursor="Hand" Style="{StaticResource ActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 " FontSize="14"/>
                                <TextBlock Text="Export Full Category" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Push to n8n -->
                        <Button x:Name="BtnPushN8n" Click="BtnPushN8n_Click" 
                                Background="#EA580C" Foreground="#FFFFFF" FontWeight="Bold"
                                Padding="12,8" Margin="0,0,8,6" Cursor="Hand" Style="{StaticResource ActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀 " FontSize="14"/>
                                <TextBlock Text="Push to Local n8n" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Tabs: Visual Architecture Canvas & JSON Code Viewer -->
                    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                        <!-- TAB 1: VISUAL FLOW CANVAS -->
                        <TabItem Header="🎨 Visual Architecture Canvas" Style="{StaticResource TabHeaderStyle}">
                            <Border Background="#070B12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="0,8,8,8">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Canvas x:Name="PnlVisualCanvas" Width="1200" Height="600" Background="#060910">
                                        <!-- Grid overlay -->
                                    </Canvas>
                                </ScrollViewer>
                            </Border>
                        </TabItem>

                        <!-- TAB 2: JSON CODE EDITOR -->
                        <TabItem Header="💻 JSON Code &amp; Schema" Style="{StaticResource TabHeaderStyle}">
                            <Border Background="#070B12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="0,8,8,8" Padding="8">
                                <TextBox x:Name="TxtJsonViewer" 
                                         Background="Transparent" Foreground="#38BDF8" BorderThickness="0"
                                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                                         IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"
                                         Text="// Click on any workflow from the list to preview JSON code and visual architecture graph..."/>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ─── STATUS BAR ─── -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Ready • 22,500 workflows available" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Created by Hsini Mohamed • https://hsini.dev" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
