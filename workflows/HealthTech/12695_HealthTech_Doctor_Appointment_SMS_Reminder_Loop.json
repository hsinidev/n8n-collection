  "nodes": [
    {
      "id": "45382161-8381-44ec-b1be-351fc2be3a06",
      "name": "Cron Scheduler (1)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        295
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "notes": "Automated enterprise step 1 for HealthTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "4f4c3277-e024-48e8-9f4c-d814c3bed6c4",
      "name": "Postgres Data Sync (2)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        225
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 2 for HealthTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "fa232ea9-175a-4be3-b17e-ebcb37d9a6ae",
      "name": "Twilio SMS Dispatcher (3)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1.2,
      "position": [
        760,
        325
      ],
      "parameters": {
        "message": "=Alert: {{ $json.alert || 'System notification' }}"
      },
      "notes": "Automated enterprise step 3 for HealthTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "9783f63f-a022-47de-995d-6f189f1b8ae6",
      "name": "Slack Notification (4)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1020,
        375
      ],
      "parameters": {
        "channel": "automation-alerts",
        "text": "=\u26a1 Enterprise Event Executed: {{ $json.event || 'Success' }}"
      },
      "notes": "Automated enterprise step 4 for HealthTech workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
    "Cron Scheduler (1)": {
      "main": [
        [
          {
            "node": "Postgres Data Sync (2)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres Data Sync (2)": {
      "main": [
        [
          {
            "node": "Twilio SMS Dispatcher (3)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Twilio SMS Dispatcher (3)": {
      "main": [
        [
          {
            "node": "Slack Notification (4)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": false,
    "saveExecutionProgress": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  }
}