  "nodes": [
    {
      "id": "737b345f-77aa-467f-b72c-ad227917c84e",
      "name": "Webhook Trigger (1)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-ingress",
        "responseMode": "responseNode"
      },
      "notes": "Automated enterprise step 1 for ECommerceLogistics workflows. Maintained by hsini.dev."
    },
    {
      "id": "a527f2e7-ceeb-4b8e-b754-169efc936d39",
      "name": "Twilio SMS Dispatcher (2)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1.2,
      "position": [
        500,
        365
      ],
      "parameters": {
        "message": "=Alert: {{ $json.alert || 'System notification' }}"
      },
      "notes": "Automated enterprise step 2 for ECommerceLogistics workflows. Maintained by hsini.dev."
    },
    {
      "id": "7796ab33-b93a-49cf-8a4e-2d72cc8cb532",
      "name": "Postgres Data Sync (3)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        760,
        370
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 3 for ECommerceLogistics workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
    "Webhook Trigger (1)": {
      "main": [
