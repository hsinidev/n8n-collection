      "id": "a172a3f8-002e-4194-b9ce-34bae29a3217",
      "name": "Slack Notification (3)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        760,
        340
      ],
      "parameters": {
        "channel": "automation-alerts",
        "text": "=\u26a1 Enterprise Event Executed: {{ $json.event || 'Success' }}"
      },
      "notes": "Automated enterprise step 3 for CyberSecurity workflows. Maintained by hsini.dev."
    },
    {
      "id": "bf274efc-34bb-4b88-9704-fb925aa3c92f",
      "name": "Postgres Data Sync (4)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 4 for CyberSecurity workflows. Maintained by hsini.dev."
    }
  ],
