{
  "id": "wflow_79006df8e6",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12412",
  "meta": {
    "instanceId": "inst-e853392b",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:52.355248+00:00",
    "updatedAt": "2026-08-14T17:32:52.355248+00:00",
