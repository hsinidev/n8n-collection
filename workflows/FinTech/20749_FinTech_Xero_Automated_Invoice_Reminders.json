  "nodes": [
    {
      "id": "cdda03f6-8842-4c7c-ba58-5cca85811e11",
      "name": "Cron Scheduler (1)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        320
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "notes": "Automated enterprise step 1 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "fd28fa5c-c4ad-405d-a324-12498b0a1679",
      "name": "HTTP Enterprise Connector (2)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        250
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.hsini.dev/v1/enterprise-endpoint",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "notes": "Automated enterprise step 2 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "f55f4f30-6c5a-40f9-99f4-f2cc90f69d28",
      "name": "SMTP Email Dispatcher (3)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        760,
        315
      ],
      "parameters": {
        "fromEmail": "notifications@hsini.dev",
        "toEmail": "=admin@hsini.dev",
        "subject": "=Alert: {{ $json.title || 'Enterprise Notification' }}"
      },
      "notes": "Automated enterprise step 3 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "51a4de83-f3aa-48ff-919b-a504d912cb56",
      "name": "Slack Notification (4)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1020,
        335
      ],
      "parameters": {
        "channel": "automation-alerts",
        "text": "=\u26a1 Enterprise Event Executed: {{ $json.event || 'Success' }}"
      },
      "notes": "Automated enterprise step 4 for FinTech workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
    "Cron Scheduler (1)": {
      "main": [
        [
          {
            "node": "HTTP Enterprise Connector (2)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Enterprise Connector (2)": {
      "main": [
        [
          {
            "node": "SMTP Email Dispatcher (3)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMTP Email Dispatcher (3)": {
      "main": [
        [
          {
            "node": "Slack Notification (4)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": false,
    "saveExecutionProgress": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "callerPolicy": "workflowsFromSameOwner",
