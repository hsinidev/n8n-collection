{
  "id": "wflow_0ee26f7b2d",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12880",
  "meta": {
    "instanceId": "inst-38853d8d",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:53.294786+00:00",
    "updatedAt": "2026-08-14T17:32:53.294786+00:00",
