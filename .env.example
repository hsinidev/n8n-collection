# Database Configuration
POSTGRES_USER=n8n
POSTGRES_PASSWORD=generate_strong_postgres_password_here
POSTGRES_DB=n8n

# Redis Configuration (For Enterprise Queue Mode)
REDIS_PASSWORD=generate_strong_redis_password_here

# Domain & Protocol (For Production / VPS)
DOMAIN_NAME=n8n.hsini.dev
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.hsini.dev/

# System Tuning
TIMEZONE=UTC
WORKER_CONCURRENCY=15
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# Function Security Flags
NODE_FUNCTION_ALLOW_BUILTIN=*
NODE_FUNCTION_ALLOW_EXTERNAL=*
