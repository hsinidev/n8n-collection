      "name": "Webhook Trigger (1)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        365
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-ingress",
        "responseMode": "responseNode"
      },
      "notes": "Automated enterprise step 1 for HealthTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "99518f79-d509-4d96-9533-efb56bbb7b2a",
      "name": "Postgres Data Sync (2)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        270
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 2 for HealthTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "bb08a857-9458-4ae7-8cd4-a0efe4cc0339",
      "name": "SMTP Email Dispatcher (3)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        760,
        345
      ],
      "parameters": {
        "fromEmail": "notifications@hsini.dev",
        "toEmail": "=admin@hsini.dev",
        "subject": "=Alert: {{ $json.title || 'Enterprise Notification' }}"
      },
      "notes": "Automated enterprise step 3 for HealthTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "d190efe3-7ebd-4947-b0a8-f556aebd46cd",
      "name": "Twilio SMS Dispatcher (4)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1.2,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "message": "=Alert: {{ $json.alert || 'System notification' }}"
      },
      "notes": "Automated enterprise step 4 for HealthTech workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
