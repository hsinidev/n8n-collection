    },
    {
      "id": "767da190-459e-47cb-a4f8-3b2b35a7a61c",
      "name": "HTTP Enterprise Connector (2)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.hsini.dev/v1/enterprise-endpoint",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "notes": "Automated enterprise step 2 for IoTEdge workflows. Maintained by hsini.dev."
    },
    {
      "id": "db3a3a9f-c363-451c-b635-0a36a8503369",
      "name": "Postgres Data Sync (3)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        760,
        375
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 3 for IoTEdge workflows. Maintained by hsini.dev."
    }
  ],
