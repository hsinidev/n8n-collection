{
  "id": "wflow_d13bda6c8d",
  "name": "Snowflake Daily Data Warehouse Sync - Enterprise Suite #16801",
  "meta": {
    "instanceId": "inst-de6eece6",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:33:17.658412+00:00",
    "updatedAt": "2026-08-14T17:33:17.658412+00:00",
