{
  "id": "wflow_53e938b6be",
  "name": "Snowflake Daily Data Warehouse Sync - Enterprise Suite #16585",
  "meta": {
    "instanceId": "inst-6f28ac8f",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:33:16.782328+00:00",
