{
  "id": "wflow_d4b5e00991",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12515",
  "meta": {
    "instanceId": "inst-404d9e94",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:52.572454+00:00",
    "updatedAt": "2026-08-14T17:32:52.572454+00:00",
