{
  "id": "wflow_fdf99a7091",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #21663",
  "meta": {
    "instanceId": "inst-775298b3",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:38:14.370965+00:00",
    "updatedAt": "2026-08-14T17:38:14.370965+00:00",
