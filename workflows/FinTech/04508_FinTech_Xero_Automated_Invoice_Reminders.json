    },
    {
      "id": "ed6e0867-9fc3-4b86-b6e9-571fba0a97be",
      "name": "HTTP Enterprise Connector (2)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        355
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.hsini.dev/v1/enterprise-endpoint",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "notes": "Automated enterprise step 2 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "8737d3bd-6ccd-47cd-a630-a61381084787",
