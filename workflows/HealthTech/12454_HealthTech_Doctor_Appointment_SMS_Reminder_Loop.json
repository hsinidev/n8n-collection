{
  "id": "wflow_dc663b25b7",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12454",
  "meta": {
    "instanceId": "inst-4803d646",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:52.442452+00:00",
