  "nodes": [
    {
      "id": "f523e5e1-8c7a-4fb5-95ec-d221f28bce47",
      "name": "Cron Scheduler (1)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        360
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "notes": "Automated enterprise step 1 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "5d0fe823-dce0-4707-aaa2-57329a895697",
      "name": "HTTP Enterprise Connector (2)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        345
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.hsini.dev/v1/enterprise-endpoint",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "notes": "Automated enterprise step 2 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "4e5bda7f-b924-4b1b-a099-3cd02585e92a",
      "name": "SMTP Email Dispatcher (3)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        760,
        365
      ],
      "parameters": {
        "fromEmail": "notifications@hsini.dev",
        "toEmail": "=admin@hsini.dev",
        "subject": "=Alert: {{ $json.title || 'Enterprise Notification' }}"
      },
      "notes": "Automated enterprise step 3 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "d13d30c4-dfda-42ec-a32e-e310783a29ae",
      "name": "Slack Notification (4)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1020,
        225
      ],
      "parameters": {
        "channel": "automation-alerts",
        "text": "=\u26a1 Enterprise Event Executed: {{ $json.event || 'Success' }}"
      },
      "notes": "Automated enterprise step 4 for FinTech workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
    "Cron Scheduler (1)": {
      "main": [
        [
          {
            "node": "HTTP Enterprise Connector (2)",
