  "nodes": [
    {
      "id": "cbf5bb2f-2372-4ce7-92ca-f3fcedc71a03",
      "name": "Stripe Webhook Trigger (1)",
      "type": "n8n-nodes-base.stripeTrigger",
      "typeVersion": 1,
      "position": [
        240,
        250
      ],
      "parameters": {
        "events": [
          "payment_intent.succeeded",
          "charge.dispute.created"
        ]
      },
      "notes": "Automated enterprise step 1 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "77d21e68-e427-4020-97bf-522faf0fcbee",
      "name": "Slack Notification (2)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        500,
        310
      ],
      "parameters": {
        "channel": "automation-alerts",
        "text": "=\u26a1 Enterprise Event Executed: {{ $json.event || 'Success' }}"
      },
      "notes": "Automated enterprise step 2 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "d4745d2c-b501-4156-929d-e1526664455a",
      "name": "Postgres Data Sync (3)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        760,
        320
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 3 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "90c6045e-b60f-4a5b-9795-9529bde3778f",
      "name": "SMTP Email Dispatcher (4)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1020,
        350
      ],
      "parameters": {
        "fromEmail": "notifications@hsini.dev",
        "toEmail": "=admin@hsini.dev",
        "subject": "=Alert: {{ $json.title || 'Enterprise Notification' }}"
      },
      "notes": "Automated enterprise step 4 for FinTech workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
    "Stripe Webhook Trigger (1)": {
      "main": [
        [
          {
            "node": "Slack Notification (2)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack Notification (2)": {
      "main": [
        [
          {
            "node": "Postgres Data Sync (3)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres Data Sync (3)": {
      "main": [
        [
          {
            "node": "SMTP Email Dispatcher (4)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": false,
