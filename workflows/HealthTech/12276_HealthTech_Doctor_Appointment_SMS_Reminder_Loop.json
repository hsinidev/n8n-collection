{
  "id": "wflow_5def1ddd3c",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12276",
  "meta": {
    "instanceId": "inst-45ad2627",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:52.119202+00:00",
    "updatedAt": "2026-08-14T17:32:52.119202+00:00",
