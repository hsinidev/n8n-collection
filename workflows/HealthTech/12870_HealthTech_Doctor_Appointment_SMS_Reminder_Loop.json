{
  "id": "wflow_1b5dbeec1f",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12870",
  "meta": {
    "instanceId": "inst-7e57165b",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:53.280324+00:00",
    "updatedAt": "2026-08-14T17:32:53.280324+00:00",
