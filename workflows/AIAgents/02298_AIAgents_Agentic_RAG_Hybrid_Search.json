      "position": [
        1020,
        235
      ],
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "model": "gpt-4o",
        "messages": {
          "values": [
            {
              "content": "=Perform enterprise automated decision logic on input: {{ JSON.stringify($json) }}"
            }
          ]
        }
      },
      "notes": "Automated enterprise step 4 for AIAgents workflows. Maintained by hsini.dev."
    },
    {
      "id": "0f3dcc98-8973-4e4f-aeb7-cb86d97c5ec1",
      "name": "Webhook Response (5)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1280,
        345
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"data\": $json,\n  \"architect\": \"Hsini Mohamed (https://hsini.dev)\"\n}"
      },
      "notes": "Automated enterprise step 5 for AIAgents workflows. Maintained by hsini.dev."
    }
