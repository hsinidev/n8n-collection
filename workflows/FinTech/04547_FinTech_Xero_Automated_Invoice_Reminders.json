            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMTP Email Dispatcher (3)": {
      "main": [
        [
          {
            "node": "Slack Notification (4)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
