    {
      "id": "33742c12-1ba4-418f-bea5-1293a5b5938b",
      "name": "HTTP Enterprise Connector (2)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        370
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.hsini.dev/v1/enterprise-endpoint",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "notes": "Automated enterprise step 2 for FinTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "fa060001-e196-4c42-bed2-b17e0a2e7cbc",
