{
  "id": "wflow_605f06ca3a",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12779",
  "meta": {
    "instanceId": "inst-94962538",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:53.081367+00:00",
    "updatedAt": "2026-08-14T17:32:53.081367+00:00",
