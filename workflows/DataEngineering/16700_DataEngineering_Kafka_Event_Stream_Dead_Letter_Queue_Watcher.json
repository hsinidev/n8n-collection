      "name": "Cron Scheduler (1)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        280
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
