      "typeVersion": 2.5,
      "position": [
        760,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 3 for AIAgents workflows. Maintained by hsini.dev."
    },
    {
      "id": "af75e751-9d4e-4a27-80b6-387adbbaa6ed",
