{
  "id": "wflow_36065262e6",
  "name": "Snowflake Daily Data Warehouse Sync - Enterprise Suite #16987",
  "meta": {
    "instanceId": "inst-d547bd6b",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:33:18.811938+00:00",
    "updatedAt": "2026-08-14T17:33:18.811938+00:00",
