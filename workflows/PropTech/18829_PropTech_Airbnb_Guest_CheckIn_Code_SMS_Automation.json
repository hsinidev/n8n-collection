      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1.2,
      "position": [
        500,
        225
      ],
      "parameters": {
        "message": "=Alert: {{ $json.alert || 'System notification' }}"
      },
      "notes": "Automated enterprise step 2 for PropTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "0d01e46a-04d8-4bf7-b477-40fa9e77ab09",
      "name": "Postgres Data Sync (3)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        760,
        320
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 3 for PropTech workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
