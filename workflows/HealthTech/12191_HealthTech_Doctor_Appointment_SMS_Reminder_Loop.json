{
  "id": "wflow_1fea7887ce",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12191",
  "meta": {
    "instanceId": "inst-5c582bb6",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:51.949572+00:00",
