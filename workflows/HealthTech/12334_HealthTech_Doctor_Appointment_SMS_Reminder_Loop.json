{
  "id": "wflow_df07017c9f",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12334",
  "meta": {
    "instanceId": "inst-22243bb9",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:52.222728+00:00",
