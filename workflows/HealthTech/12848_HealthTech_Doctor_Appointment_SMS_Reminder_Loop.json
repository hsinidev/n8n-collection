{
  "id": "wflow_4db5619a11",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12848",
  "meta": {
    "instanceId": "inst-9db69da8",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:53.234916+00:00",
