{
  "id": "wflow_dd57d9fd0f",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12221",
  "meta": {
    "instanceId": "inst-f5d52e74",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:52.023376+00:00",
