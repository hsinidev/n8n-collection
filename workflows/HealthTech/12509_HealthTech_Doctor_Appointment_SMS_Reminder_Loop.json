{
  "id": "wflow_55038e0e0a",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12509",
  "meta": {
    "instanceId": "inst-545c3f85",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:52.562457+00:00",
    "updatedAt": "2026-08-14T17:32:52.562457+00:00",
