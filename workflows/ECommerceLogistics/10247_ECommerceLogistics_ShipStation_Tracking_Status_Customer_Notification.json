  "nodes": [
    {
      "id": "0ec6b246-4def-441d-b05a-2513e9b65467",
      "name": "Webhook Trigger (1)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        250
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-ingress",
        "responseMode": "responseNode"
      },
      "notes": "Automated enterprise step 1 for ECommerceLogistics workflows. Maintained by hsini.dev."
    },
    {
      "id": "d3d7a64e-7c62-45c0-857a-5049e0dc76b7",
      "name": "Twilio SMS Dispatcher (2)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1.2,
      "position": [
        500,
        330
      ],
      "parameters": {
        "message": "=Alert: {{ $json.alert || 'System notification' }}"
      },
      "notes": "Automated enterprise step 2 for ECommerceLogistics workflows. Maintained by hsini.dev."
    },
    {
      "id": "422cf446-ed70-4b0e-aba4-1b200ec5c5ad",
      "name": "Postgres Data Sync (3)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        760,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 3 for ECommerceLogistics workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
    "Webhook Trigger (1)": {
      "main": [
