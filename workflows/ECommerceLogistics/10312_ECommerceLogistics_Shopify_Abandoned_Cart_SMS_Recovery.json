  "nodes": [
    {
      "id": "bb62392f-70fe-4b84-9644-22e7b658a92e",
      "name": "Shopify Store Event (1)",
      "type": "n8n-nodes-base.shopifyTrigger",
      "typeVersion": 1,
      "position": [
        240,
