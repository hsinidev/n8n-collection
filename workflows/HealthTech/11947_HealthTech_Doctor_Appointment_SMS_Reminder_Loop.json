{
  "id": "wflow_92b48cd647",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #11947",
  "meta": {
    "instanceId": "inst-cbbddcf8",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:51.462660+00:00",
