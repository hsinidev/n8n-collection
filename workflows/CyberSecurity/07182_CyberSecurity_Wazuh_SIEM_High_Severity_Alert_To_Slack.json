      "id": "39f6225c-76fe-49a8-a322-e68d96bd204b",
      "name": "Slack Notification (3)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        760,
        250
      ],
      "parameters": {
        "channel": "automation-alerts",
        "text": "=\u26a1 Enterprise Event Executed: {{ $json.event || 'Success' }}"
      },
      "notes": "Automated enterprise step 3 for CyberSecurity workflows. Maintained by hsini.dev."
    },
    {
      "id": "98d538b6-bb3d-41f9-b0ba-cdde61405ed3",
      "name": "Postgres Data Sync (4)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1020,
        360
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 4 for CyberSecurity workflows. Maintained by hsini.dev."
    }
  ],
