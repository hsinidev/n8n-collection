  "nodes": [
    {
      "id": "c7be5f22-eeb3-47ad-b0c7-f198913eb2bf",
      "name": "Webhook Trigger (1)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        230
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-ingress",
        "responseMode": "responseNode"
      },
      "notes": "Automated enterprise step 1 for PropTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "3078b600-e0b0-4916-9e34-38ff89d599a4",
      "name": "Twilio SMS Dispatcher (2)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1.2,
      "position": [
        500,
        375
      ],
      "parameters": {
        "message": "=Alert: {{ $json.alert || 'System notification' }}"
      },
      "notes": "Automated enterprise step 2 for PropTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "d13d132f-82e6-4610-8d15-a4f626f9780b",
      "name": "Postgres Data Sync (3)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        760,
        360
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 3 for PropTech workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
    "Webhook Trigger (1)": {
      "main": [
        [
          {
            "node": "Twilio SMS Dispatcher (2)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Twilio SMS Dispatcher (2)": {
      "main": [
        [
          {
            "node": "Postgres Data Sync (3)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
