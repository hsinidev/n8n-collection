      "name": "Webhook Trigger (1)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        375
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-ingress",
        "responseMode": "responseNode"
      },
