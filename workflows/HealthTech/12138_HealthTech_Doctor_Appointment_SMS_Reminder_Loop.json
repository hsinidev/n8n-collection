{
  "id": "wflow_437b7d83fc",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12138",
  "meta": {
    "instanceId": "inst-69ed1c01",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:51.814640+00:00",
    "updatedAt": "2026-08-14T17:32:51.814640+00:00",
