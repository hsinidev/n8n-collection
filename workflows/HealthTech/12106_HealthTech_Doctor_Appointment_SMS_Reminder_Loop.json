{
  "id": "wflow_66bf47c8e9",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12106",
  "meta": {
    "instanceId": "inst-bf432eca",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:51.746202+00:00",
