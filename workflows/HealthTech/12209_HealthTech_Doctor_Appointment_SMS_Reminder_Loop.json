{
  "id": "wflow_6b0ee6d70b",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12209",
  "meta": {
    "instanceId": "inst-9e6759f8",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:51.979163+00:00",
