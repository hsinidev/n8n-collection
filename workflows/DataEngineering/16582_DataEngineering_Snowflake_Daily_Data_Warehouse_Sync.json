  "nodes": [
    {
      "id": "e41a8ea9-d493-410e-9ef9-5e3f28972663",
      "name": "Cron Scheduler (1)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        295
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "notes": "Automated enterprise step 1 for DataEngineering workflows. Maintained by hsini.dev."
    },
    {
      "id": "5afcfcf1-3ad8-4748-b6d0-4fb906e2f806",
      "name": "Postgres Data Sync (2)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        275
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 2 for DataEngineering workflows. Maintained by hsini.dev."
    },
    {
      "id": "844d3ab1-deed-45c6-a1b0-f1bc04a0b733",
      "name": "HTTP Enterprise Connector (3)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        230
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.hsini.dev/v1/enterprise-endpoint",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "notes": "Automated enterprise step 3 for DataEngineering workflows. Maintained by hsini.dev."
    },
    {
      "id": "d1e942f6-ff81-4a4e-a30c-8c1d60a42db5",
      "name": "Slack Notification (4)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1020,
        340
      ],
      "parameters": {
        "channel": "automation-alerts",
        "text": "=\u26a1 Enterprise Event Executed: {{ $json.event || 'Success' }}"
      },
      "notes": "Automated enterprise step 4 for DataEngineering workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
    "Cron Scheduler (1)": {
      "main": [
        [
          {
            "node": "Postgres Data Sync (2)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres Data Sync (2)": {
      "main": [
        [
          {
            "node": "HTTP Enterprise Connector (3)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Enterprise Connector (3)": {
      "main": [
        [
          {
            "node": "Slack Notification (4)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": false,
    "saveExecutionProgress": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  }
