      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        760,
        255
      ],
      "parameters": {
        "channel": "automation-alerts",
        "text": "=\u26a1 Enterprise Event Executed: {{ $json.event || 'Success' }}"
      },
      "notes": "Automated enterprise step 3 for CyberSecurity workflows. Maintained by hsini.dev."
    },
    {
      "id": "05e8b292-fc31-4925-819f-ba2d8ee62a73",
