{
  "id": "wflow_f332ac55d5",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12242",
  "meta": {
    "instanceId": "inst-9dc2a965",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:52.063245+00:00",
