{
  "id": "wflow_2f9bacf385",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12480",
  "meta": {
    "instanceId": "inst-b426c87c",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:52.501718+00:00",
