      "typeVersion": 4.2,
      "position": [
        500,
        315
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.hsini.dev/v1/enterprise-endpoint",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
