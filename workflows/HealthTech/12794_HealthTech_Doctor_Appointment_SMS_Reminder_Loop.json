{
  "id": "wflow_a7932a52d3",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12794",
  "meta": {
    "instanceId": "inst-acfde6f6",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:53.105485+00:00",
    "updatedAt": "2026-08-14T17:32:53.105485+00:00",
