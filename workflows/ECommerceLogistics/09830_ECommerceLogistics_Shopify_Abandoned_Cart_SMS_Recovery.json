  "nodes": [
    {
      "id": "8c324f10-4977-4518-a41a-03eb4aa376ee",
      "name": "Shopify Store Event (1)",
      "type": "n8n-nodes-base.shopifyTrigger",
      "typeVersion": 1,
      "position": [
        240,
