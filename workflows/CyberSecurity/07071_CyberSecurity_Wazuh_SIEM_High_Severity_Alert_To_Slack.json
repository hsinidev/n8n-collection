      "position": [
        1020,
        255
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 4 for CyberSecurity workflows. Maintained by hsini.dev."
    }
