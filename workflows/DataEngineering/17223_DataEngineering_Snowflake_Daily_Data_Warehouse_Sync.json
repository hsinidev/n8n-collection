{
  "id": "wflow_a4e7bd2505",
  "name": "Snowflake Daily Data Warehouse Sync - Enterprise Suite #17223",
  "meta": {
    "instanceId": "inst-432fbbd8",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:33:20.172140+00:00",
    "updatedAt": "2026-08-14T17:33:20.172140+00:00",
