  "nodes": [
    {
      "id": "2fc3caf8-73c5-41a1-9c88-3c6e20a193a5",
      "name": "Webhook Trigger (1)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-ingress",
        "responseMode": "responseNode"
      },
      "notes": "Automated enterprise step 1 for HealthTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "9fa3d933-e9b0-4ced-a06c-4e5c73e6621d",
      "name": "Postgres Data Sync (2)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        275
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 2 for HealthTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "0a42f4e7-f700-41b7-8182-3c37347356a7",
      "name": "SMTP Email Dispatcher (3)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        760,
        280
      ],
      "parameters": {
        "fromEmail": "notifications@hsini.dev",
        "toEmail": "=admin@hsini.dev",
        "subject": "=Alert: {{ $json.title || 'Enterprise Notification' }}"
      },
      "notes": "Automated enterprise step 3 for HealthTech workflows. Maintained by hsini.dev."
    },
    {
      "id": "d3210ef0-c5b9-4671-a721-46eee52ac066",
      "name": "Twilio SMS Dispatcher (4)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1.2,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "message": "=Alert: {{ $json.alert || 'System notification' }}"
      },
      "notes": "Automated enterprise step 4 for HealthTech workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
    "Webhook Trigger (1)": {
      "main": [
        [
          {
            "node": "Postgres Data Sync (2)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres Data Sync (2)": {
      "main": [
        [
          {
            "node": "SMTP Email Dispatcher (3)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMTP Email Dispatcher (3)": {
      "main": [
        [
          {
            "node": "Twilio SMS Dispatcher (4)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": false,
    "saveExecutionProgress": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "callerPolicy": "workflowsFromSameOwner",
