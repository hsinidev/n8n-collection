      "name": "Webhook Trigger (1)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        350
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-ingress",
        "responseMode": "responseNode"
      },
      "notes": "Automated enterprise step 1 for ECommerceLogistics workflows. Maintained by hsini.dev."
    },
    {
      "id": "642a3cd2-d48f-4a70-b390-0da5fd7692a7",
      "name": "Twilio SMS Dispatcher (2)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1.2,
      "position": [
        500,
        375
      ],
      "parameters": {
        "message": "=Alert: {{ $json.alert || 'System notification' }}"
      },
      "notes": "Automated enterprise step 2 for ECommerceLogistics workflows. Maintained by hsini.dev."
    },
    {
      "id": "1eb008d9-feaa-42e6-9429-6ee97ef42cbb",
      "name": "Postgres Data Sync (3)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        760,
        375
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enterprise_events (payload, executed_at) VALUES ('{{ JSON.stringify($json) }}', NOW());"
      },
      "notes": "Automated enterprise step 3 for ECommerceLogistics workflows. Maintained by hsini.dev."
    }
  ],
  "connections": {
    "Webhook Trigger (1)": {
      "main": [
