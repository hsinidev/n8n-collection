{
  "id": "wflow_2bfcaa6c55",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12399",
  "meta": {
    "instanceId": "inst-0e133de8",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:52.332243+00:00",
    "updatedAt": "2026-08-14T17:32:52.332243+00:00",
