{
  "id": "wflow_1273b533a1",
  "name": "Doctor Appointment SMS Reminder Loop - Enterprise Suite #12006",
  "meta": {
    "instanceId": "inst-d92f7e97",
    "versionId": "2.4.0",
    "createdAt": "2026-08-14T17:32:51.573012+00:00",
